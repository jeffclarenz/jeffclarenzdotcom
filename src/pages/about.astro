---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="About — Jeff Clarenz">
  <Nav active="about" />
  <main style="flex: 1;">
    <div class="jc-container animate-up" style="padding-top: 72px; padding-bottom: 20px;">
      <div class="r-about-grid" style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: start;">
        <div>
          <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: 40px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; margin: 0 0 28px;">I'm Jeff. Founder, CTO, and the one who wrote most of the code.</h1>
          <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px;">I build and run business software. I'm based in the Philippines and I work hands-on across architecture, infrastructure, and development. I don't hand off the technical work — I do it.</p>
          <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px;">My stack is ASP.NET Core, C#, MySQL, and vanilla JavaScript. I deploy to Azure and AWS depending on the project. I prefer stable, proven tools over new ones, and I keep infrastructure simple on purpose.</p>
          <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0;">Alongside the company work, I build my own apps independently — a trivia game that's live on the App Store, and a short-form trivia feed app currently in progress.</p>

          <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--subtle, #9aa39e); margin: 48px 0 18px;">— how I work</div>
          <div style="display: grid; gap: 14px;">
            <div style="display: flex; gap: 14px;"><span style="color:#1f9d63; font-family:'JetBrains Mono',monospace;">→</span><p style="margin:0; font-size:15px; line-height:1.6; color:var(--body-text, #3a423d);">I use proven technologies. I'm not interested in rewriting systems around whatever framework is popular this year.</p></div>
            <div style="display: flex; gap: 14px;"><span style="color:#1f9d63; font-family:'JetBrains Mono',monospace;">→</span><p style="margin:0; font-size:15px; line-height:1.6; color:var(--body-text, #3a423d);">Infrastructure should be boring. If it's interesting, something is wrong.</p></div>
            <div style="display: flex; gap: 14px;"><span style="color:#1f9d63; font-family:'JetBrains Mono',monospace;">→</span><p style="margin:0; font-size:15px; line-height:1.6; color:var(--body-text, #3a423d);">I use AI tools to write code faster. The judgement about what to build and how to structure it is still mine.</p></div>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div style="border: 1px solid var(--border, #e3e8e6); border-radius: 4px; background: var(--surface, #fff); padding: 22px;">
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; color: var(--subtle, #9aa39e); text-transform: uppercase;">Stack</div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">ASP.NET Core</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">C#</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">MySQL</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">Vanilla JS</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">Azure</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">AWS</span>
            </div>
          </div>
          <div style="border: 1px solid var(--border, #e3e8e6); border-radius: 4px; background: var(--surface, #fff); padding: 22px;">
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; color: var(--subtle, #9aa39e); text-transform: uppercase;">Off the clock</div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">travel</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">photography</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">Lego</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mid, #45504b); border: 1px solid var(--border, #dbe0dd); border-radius: 999px; padding: 5px 12px;">Ingress</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
