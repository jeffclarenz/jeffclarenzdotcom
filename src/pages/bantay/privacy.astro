---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const contact = "contact@knowout.app";
---
<Layout title="Bantay privacy policy — Jeff Clarenz">
  <Nav />
  <main style="flex: 1;">
    <div class="jc-container animate-up" style="padding-top: 72px; padding-bottom: 40px; max-width: 720px;">
      <h1 class="r-page-h1" style="font-family: 'Space Grotesk', sans-serif; font-size: 40px; font-weight: 600; letter-spacing: -0.025em; margin: 0 0 8px; line-height: 1.1;">Bantay: privacy policy</h1>
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--subtle, #9aa39e); margin-bottom: 32px;">Last updated 7 November 2026</div>
      <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px;">Bantay is a single-player game that plays fully offline. It has no ads and no analytics, and it does not need an account.</p>
      <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 600; margin: 28px 0 10px;">Stays on your phone</h2>
      <ul style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px; padding-left: 22px;">
        <li>Your progress, settings, saved run and best scores are stored only on your phone.</li>
        <li><strong>No ads, no analytics, no tracking.</strong> The game contains no advertising or analytics code.</li>
        <li><strong>No extra permissions.</strong> It does not ask for your location, contacts, camera, microphone or files.</li>
      </ul>
      <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 600; margin: 28px 0 10px;">Google Play Games (optional)</h2>
      <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px;">If you are signed in to Google Play Games on your phone, Bantay uses it for the Daily Challenge leaderboard. Then:</p>
      <ul style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px; padding-left: 22px;">
        <li>Google receives your Play Games player ID and your Daily Challenge scores.</li>
        <li>Your Play Games name and score appear on the leaderboard, which other players can see.</li>
        <li>Nothing else is sent: not your progress, settings or other scores.</li>
      </ul>
      <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px;">Google handles Play Games sign-in and leaderboards under <a href="https://policies.google.com/privacy">Google's privacy policy</a>. You can play without signing in, and you can manage or delete your Play Games profile in the Google Play Games app or your Google account settings.</p>
      <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0;">Questions: <a href={`mailto:${contact}`}>{contact}</a></p>
    </div>
  </main>
  <Footer />
</Layout>
