---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const contact = "contact@knowout.app";
---
<Layout title="Bantay privacy policy — Jeff Clarenz">
  <Nav />
  <main style="flex: 1;">
    <div class="jc-container animate-up" style="padding-top: 72px; padding-bottom: 40px; max-width: 720px;">
      <h1 class="r-page-h1" style="font-family: 'Space Grotesk', sans-serif; font-size: 40px; font-weight: 600; letter-spacing: -0.025em; margin: 0 0 8px; line-height: 1.1;">Bantay: privacy policy</h1>
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--subtle, #9aa39e); margin-bottom: 32px;">Last updated 4 November 2026</div>
      <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px;">Bantay is a single-player game. It does not collect, store or share any personal information.</p>
      <ul style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px; padding-left: 22px;">
        <li><strong>No accounts.</strong> You don't sign in to play.</li>
        <li><strong>No data leaves your device.</strong> Your progress, settings and saved run are stored only on your phone.</li>
        <li><strong>No ads, no analytics, no tracking.</strong> The game contains no advertising or analytics code.</li>
        <li><strong>No extra permissions.</strong> It does not ask for your location, contacts, camera, microphone or files.</li>
      </ul>
      <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0 0 18px;">If a future version adds optional Google Play Games sign-in for achievements and leaderboards, Google handles that sign-in under Google's own privacy policy, and this page will be updated before that version is released.</p>
      <p style="font-size: 16px; line-height: 1.7; color: var(--body-text, #3a423d); margin: 0;">Questions: <a href={`mailto:${contact}`}>{contact}</a></p>
    </div>
  </main>
  <Footer />
</Layout>
