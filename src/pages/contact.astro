---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Contact — Jeff Clarenz">
  <Nav active="contact" />
  <main>
    <div class="r-px animate-up" style="max-width: 860px; margin: 0 auto; padding: 72px 40px 20px;">
      <h1 class="r-page-h1" style="font-family: 'Space Grotesk', sans-serif; font-size: 44px; font-weight: 600; letter-spacing: -0.025em; margin: 0 0 16px; line-height: 1.08;">Let's talk.</h1>
      <p style="font-size: 16px; line-height: 1.65; color: var(--muted, #5a635e); margin: 0 0 40px; max-width: 520px;">Software, infrastructure, a project, or just found one of my apps and want to say hi — find me on any of these.</p>

      <div class="r-3links" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;">
        <a href="https://github.com/jeffclarenz" target="_blank" rel="noopener" style="text-decoration: none; border: 1px solid var(--border, #e3e8e6); border-radius: 4px; background: var(--surface, #fff); padding: 18px 20px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--subtle, #9aa39e);">CODE</div>
          <div style="font-size: 15px; color: var(--ink, #141821); margin-top: 6px;">GitHub →</div>
        </a>
        <a href="https://x.com/jeffclarenz" target="_blank" rel="noopener" style="text-decoration: none; border: 1px solid var(--border, #e3e8e6); border-radius: 4px; background: var(--surface, #fff); padding: 18px 20px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--subtle, #9aa39e);">POSTS</div>
          <div style="font-size: 15px; color: var(--ink, #141821); margin-top: 6px;">X / Twitter →</div>
        </a>
        <a href="https://linkedin.com/in/jeffclarenz" target="_blank" rel="noopener" style="text-decoration: none; border: 1px solid var(--border, #e3e8e6); border-radius: 4px; background: var(--surface, #fff); padding: 18px 20px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--subtle, #9aa39e);">WORK</div>
          <div style="font-size: 15px; color: var(--ink, #141821); margin-top: 6px;">LinkedIn →</div>
        </a>
      </div>
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--subtle, #9aa39e); margin-top: 32px;">Based in the Philippines · GMT+8</div>
    </div>
  </main>
  <Footer />
</Layout>
