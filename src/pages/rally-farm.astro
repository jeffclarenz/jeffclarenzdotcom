---
// TEMPORARY event page for a friend. Delete this file + public/rally-farm/ after Dec 5, 2026.
// Drop photos into public/rally-farm/gallery/ (jpg/png/webp), delete the placeholder-*.svg files, and add the poster at public/rally-farm/poster.jpg.
import fs from 'node:fs';
import path from 'node:path';

const galleryDir = path.join(process.cwd(), 'public/rally-farm/gallery');
const photos = fs.existsSync(galleryDir)
  ? fs.readdirSync(galleryDir).filter((f) => /\.(jpe?g|png|webp|avif|svg)$/i.test(f)).sort().map((f) => `/rally-farm/gallery/${f}`)
  : [];
// Two rows scrolling in opposite directions; repeat short sets so each strip is wide enough to loop.
const fill = (arr) => { if (!arr.length) return arr; let out = [...arr]; while (out.length < 8) out = out.concat(arr); return out; };
const odd = photos.filter((_, i) => i % 2 === 1);
const rowA = fill(photos.filter((_, i) => i % 2 === 0));
const rowB = fill(odd.length ? odd : photos);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Rally Farm Dirt Autocross · NESR 2026 Awarding</title>
<meta name="description" content="Rally Farm Dirt Autocross & NESR 2026 Awarding — December 5, 2026. Unlimited runs + lunch for ₱2,000. Register now.">
<meta property="og:title" content="Rally Farm Dirt Autocross & NESR 2026 Awarding">
<meta property="og:description" content="Dec 5, 2026 · Unlimited runs + lunch · ₱2,000 · Awarding & Christmas Party">
<meta property="og:image" content="https://jeffclarenz.com/rally-farm/poster.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
<style is:global>
  /* ============ EDIT THESE ============ */
  /* Event config lives in the <script is:inline> at the bottom (FORM_URL, venue, payment). */

  :root {
    --bg: #0c0b0a;
    --bg-2: #141210;
    --card: #1a1714;
    --line: #2c2722;
    --text: #f3ede6;
    --muted: #a39a8f;
    --dirt: #ff6a1a;      /* rally orange */
    --dirt-2: #ffb21a;    /* amber */
    --mud: #6b4a2e;
    --xmas: #2fbf71;
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font-family: 'Barlow', system-ui, sans-serif; font-size: 17px; line-height: 1.6;
    -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  .wrap { max-width: 1140px; margin: 0 auto; padding: 0 20px; }
  .display { font-family: 'Anton', Impact, sans-serif; text-transform: uppercase; letter-spacing: 0.01em; line-height: 0.95; font-weight: 400; }
  .eyebrow { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; font-size: 13px; color: var(--dirt); }
  .btn {
    display: inline-flex; align-items: center; gap: 10px; justify-content: center;
    font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 17px;
    text-transform: uppercase; letter-spacing: 0.08em; text-decoration: none;
    padding: 15px 26px; border-radius: 999px; border: 2px solid transparent; cursor: pointer;
    transition: transform .15s ease, background .15s ease, box-shadow .15s ease;
  }
  .btn-primary { background: var(--dirt); color: #140800; box-shadow: 0 10px 30px -10px rgba(255,106,26,.7); }
  .btn-primary:hover { transform: translateY(-2px); background: #ff7d36; }
  .btn-ghost { border-color: #4a423a; color: var(--text); }
  .btn-ghost:hover { border-color: var(--dirt); color: var(--dirt); }

  /* ---------- nav ---------- */
  nav.top {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    background: rgba(12,11,10,.72); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,.05);
  }
  nav.top .wrap { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { font-family: 'Anton', sans-serif; text-transform: uppercase; font-size: 20px; letter-spacing: .03em; text-decoration: none; }
  .brand span { color: var(--dirt); }
  nav.top ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  nav.top ul a { text-decoration: none; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; font-size: 14px; color: var(--muted); }
  nav.top ul a:hover { color: var(--text); }
  nav.top .btn { padding: 9px 18px; font-size: 14px; }

  /* ---------- hero ---------- */
  .hero { position: relative; padding: 120px 0 80px; min-height: 100vh; display: flex; align-items: center; isolation: isolate; }
  .hero::before { /* dust glow */
    content: ""; position: absolute; inset: 0; z-index: -2;
    background:
      radial-gradient(60% 50% at 75% 40%, rgba(255,106,26,.22), transparent 70%),
      radial-gradient(50% 40% at 10% 90%, rgba(107,74,46,.45), transparent 70%),
      var(--bg);
  }
  .hero::after { /* grain */
    content: ""; position: absolute; inset: 0; z-index: -1; opacity: .08; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }
  .hero h1 { font-size: clamp(52px, 8.4vw, 112px); margin: 18px 0 0; }
  .hero h1 .outline { color: transparent; -webkit-text-stroke: 2px var(--text); }
  .hero h1 .accent { color: var(--dirt); }
  .hero .sub { font-size: clamp(18px, 2vw, 21px); color: var(--muted); max-width: 520px; margin: 22px 0 0; }
  .hero .sub strong { color: var(--text); }
  .meta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px;
    background: rgba(255,255,255,.04); border: 1px solid var(--line);
    font-family: 'Barlow Condensed', sans-serif; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; font-size: 15px;
  }
  .chip svg { width: 16px; height: 16px; color: var(--dirt); }
  .hero .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .poster {
    position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 4 / 5;
    background: linear-gradient(160deg, #2a1d12, #120d09);
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -30px rgba(0,0,0,.9), 0 0 0 1px rgba(255,106,26,.08);
    transform: rotate(2deg);
    transition: transform .4s ease;
  }
  .poster:hover { transform: rotate(0deg) scale(1.01); }
  .poster img { width: 100%; height: 100%; object-fit: cover; }
  .poster .fallback { /* shown until poster.jpg exists */
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 28px;
    background:
      repeating-linear-gradient(-45deg, rgba(255,255,255,.025) 0 14px, transparent 14px 28px),
      radial-gradient(80% 60% at 50% 100%, rgba(255,106,26,.35), transparent 70%);
  }
  .poster .fallback .big { font-family: 'Anton', sans-serif; text-transform: uppercase; font-size: clamp(44px, 5vw, 64px); line-height: .9; }
  .poster .fallback .big em { font-style: normal; color: var(--dirt); }
  .poster .fallback small { color: var(--muted); font-family: 'Barlow Condensed', sans-serif; letter-spacing: .14em; text-transform: uppercase; }
  .poster .tag {
    position: absolute; top: 18px; right: -40px; transform: rotate(35deg);
    background: var(--dirt); color: #140800; padding: 6px 50px;
    font-family: 'Barlow Condensed', sans-serif; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; font-size: 13px;
  }

  /* countdown */
  .countdown { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 38px; max-width: 460px; }
  .countdown div { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 6px; text-align: center; }
  .countdown b { display: block; font-family: 'Anton', sans-serif; font-size: 34px; font-weight: 400; line-height: 1; font-variant-numeric: tabular-nums; }
  .countdown span { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); font-family: 'Barlow Condensed', sans-serif; font-weight: 600; }

  /* ---------- tape ---------- */
  .tape { background: var(--dirt); color: #140800; overflow: hidden; transform: rotate(-1.5deg); margin: 0 -20px; border-block: 3px solid #140800; }
  .tape-track { display: flex; gap: 40px; width: max-content; padding: 12px 0; animation: scroll 32s linear infinite; }
  .tape-track span { font-family: 'Anton', sans-serif; text-transform: uppercase; font-size: 22px; letter-spacing: .04em; white-space: nowrap; }
  .tape-track span::after { content: "✦"; margin-left: 40px; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  /* ---------- sections ---------- */
  section.block { padding: 110px 0; }
  .sec-head { margin-bottom: 48px; }
  .sec-head h2 { font-size: clamp(40px, 6vw, 72px); margin: 12px 0 0; }
  .sec-head p { color: var(--muted); max-width: 560px; margin: 14px 0 0; }

  /* details */
  .details { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .detail { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 22px; }
  .detail .ico { width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center; background: rgba(255,106,26,.12); color: var(--dirt); margin-bottom: 18px; }
  .detail .ico svg { width: 22px; height: 22px; }
  .detail h3 { margin: 0; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: .14em; font-size: 13px; color: var(--muted); }
  .detail p { margin: 6px 0 0; font-weight: 600; font-size: 19px; line-height: 1.35; }
  .detail p a { color: var(--dirt-2); }

  /* schedule */
  .schedule { position: relative; display: grid; gap: 14px; }
  .slot {
    display: grid; grid-template-columns: 150px 1fr auto; gap: 24px; align-items: center;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 28px;
    position: relative; overflow: hidden; transition: border-color .2s ease, transform .2s ease;
  }
  .slot:hover { border-color: #4a3a2c; transform: translateX(4px); }
  .slot::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--c, var(--dirt)); }
  .slot time { font-family: 'Anton', sans-serif; font-size: 44px; line-height: 1; color: var(--c, var(--dirt)); font-variant-numeric: tabular-nums; }
  .slot h3 { margin: 0; font-family: 'Barlow Condensed', sans-serif; font-size: 26px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; line-height: 1.1; }
  .slot p { margin: 4px 0 0; color: var(--muted); font-size: 16px; }
  .slot .badge { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; font-size: 12px; padding: 6px 12px; border-radius: 999px; border: 1px solid currentColor; color: var(--c, var(--dirt)); white-space: nowrap; }
  .slot.xmas { --c: var(--xmas); }
  .slot.award { --c: var(--dirt-2); }

  /* package */
  .package-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; }
  .price-card {
    position: relative; border-radius: 20px; padding: 40px; overflow: hidden;
    background: linear-gradient(155deg, #2b1608 0%, #1a1714 55%);
    border: 1px solid rgba(255,106,26,.35);
  }
  .price-card::after { content: ""; position: absolute; width: 340px; height: 340px; right: -120px; top: -120px; border-radius: 50%; background: radial-gradient(circle, rgba(255,106,26,.35), transparent 70%); pointer-events: none; }
  .price { font-family: 'Anton', sans-serif; font-size: clamp(72px, 10vw, 112px); line-height: 1; margin: 16px 0 4px; }
  .price sup { font-size: .45em; vertical-align: top; position: relative; top: .25em; margin-right: 4px; color: var(--dirt); }
  .price-card .per { color: var(--muted); font-family: 'Barlow Condensed', sans-serif; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; }
  .incl { list-style: none; padding: 0; margin: 30px 0 34px; display: grid; gap: 14px; }
  .incl li { display: flex; gap: 12px; align-items: flex-start; font-weight: 500; font-size: 18px; }
  .incl svg { flex: none; width: 22px; height: 22px; color: var(--dirt); margin-top: 3px; }
  .pay-card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 40px; display: flex; flex-direction: column; }
  .pay-card h3 { font-family: 'Barlow Condensed', sans-serif; font-size: 28px; text-transform: uppercase; margin: 0; letter-spacing: .02em; }
  .steps { counter-reset: s; list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 18px; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 38px 1fr; gap: 14px; color: var(--muted); }
  .steps li::before { content: counter(s); width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: #241f1a; border: 1px solid var(--line); color: var(--text); font-family: 'Anton', sans-serif; font-size: 17px; }
  .steps li strong { color: var(--text); display: block; }
  .pay-box { margin-top: auto; padding-top: 26px; }
  .pay-box .acct { background: #0f0d0b; border: 1px dashed #4a3a2c; border-radius: 12px; padding: 16px 18px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .pay-box .acct small { display: block; color: var(--muted); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; }
  .pay-box .acct b { font-size: 20px; letter-spacing: .03em; }
  .copy { background: transparent; border: 1px solid #4a423a; color: var(--text); border-radius: 8px; padding: 8px 14px; cursor: pointer; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; font-size: 13px; }
  .copy:hover { border-color: var(--dirt); color: var(--dirt); }

  /* register */
  .register { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .reg-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; align-items: start; }
  .checklist { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 12px; }
  .checklist li { display: flex; gap: 12px; align-items: center; padding: 14px 16px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; font-weight: 500; }
  .checklist li svg { width: 20px; height: 20px; color: var(--dirt); flex: none; }
  .note { margin-top: 22px; font-size: 15px; color: var(--muted); }
  .note a { color: var(--dirt-2); }
  .form-shell { background: #f6f3ef; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(0,0,0,.8); }
  .form-shell .bar { background: var(--card); color: var(--muted); display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 18px; font-size: 14px; border-bottom: 1px solid var(--line); }
  .form-shell .bar a { color: var(--dirt-2); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .form-shell iframe { width: 100%; height: 1500px; border: 0; display: block; background: #f6f3ef; }
  .form-placeholder { background: var(--card); color: var(--muted); padding: 60px 30px; text-align: center; }
  .form-placeholder code { color: var(--dirt-2); }

  /* season gallery */
  .gallery { padding: 110px 0 40px; overflow: hidden; }
  .strip { display: flex; gap: 18px; width: max-content; padding: 10px 0; animation: scroll 60s linear infinite; }
  .strip.rev { animation-direction: reverse; animation-duration: 70s; }
  .strips { display: grid; gap: 8px; transform: rotate(-2deg); margin: 0 -40px; }
  .strips:hover .strip { animation-play-state: paused; }
  .shot {
    flex: none; width: 340px; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; position: relative;
    border: 1px solid var(--line); background: var(--card); padding: 0; cursor: zoom-in;
    filter: saturate(.7) brightness(.85); transition: filter .35s ease, transform .35s ease;
  }
  .shot:nth-child(3n+1) { transform: rotate(-1.5deg); }
  .shot:nth-child(3n+2) { transform: rotate(1.2deg) translateY(6px); }
  .shot:hover { filter: none; transform: scale(1.05) rotate(0); z-index: 2; }
  .shot img { width: 100%; height: 100%; object-fit: cover; animation: kenburns 14s ease-in-out infinite alternate; }
  .shot:nth-child(even) img { animation-delay: -7s; }
  @keyframes kenburns { from { transform: scale(1); } to { transform: scale(1.12) translate(-2%, -2%); } }
  .shot.ph { display: grid; place-items: center; cursor: default; color: var(--muted); font-family: 'Barlow Condensed', sans-serif; letter-spacing: .14em; text-transform: uppercase; font-size: 14px;
    background: repeating-linear-gradient(-45deg, rgba(255,255,255,.03) 0 14px, transparent 14px 28px), var(--card); }
  .lightbox { position: fixed; inset: 0; z-index: 100; background: rgba(5,4,3,.92); display: none; place-items: center; padding: 24px; cursor: zoom-out; }
  .lightbox.open { display: grid; animation: fade .25s ease; }
  .lightbox img { max-width: min(1200px, 100%); max-height: 88vh; border-radius: 12px; box-shadow: 0 30px 80px rgba(0,0,0,.8); }
  @keyframes fade { from { opacity: 0; } }

  /* footer */
  footer { padding: 60px 0 100px; color: var(--muted); font-size: 15px; }
  footer .wrap { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; align-items: center; }
  footer .brand { font-size: 24px; color: var(--text); }

  /* mobile sticky cta */
  .sticky-cta { display: none; position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 60; }
  .sticky-cta .btn { width: 100%; }

  /* reveal */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .tape-track, .strip, .shot img { animation: none; }
    .strips { overflow-x: auto; }
    html { scroll-behavior: auto; }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 960px) {
    .hero-grid, .package-grid, .reg-grid { grid-template-columns: 1fr; }
    .hero { min-height: auto; padding-top: 110px; }
    .poster { max-width: 420px; margin: 0 auto; transform: rotate(0); }
    .details { grid-template-columns: 1fr 1fr; }
    nav.top ul { display: none; }
  }
  @media (max-width: 600px) {
    body { font-size: 16px; }
    .wrap { padding: 0 16px; }
    section.block { padding: 76px 0; }
    .details { grid-template-columns: 1fr; }
    .slot { grid-template-columns: 1fr; gap: 8px; padding: 22px; }
    .slot time { font-size: 38px; }
    .slot .badge { justify-self: start; }
    .price-card, .pay-card { padding: 28px 22px; }
    .hero h1 .outline { -webkit-text-stroke-width: 1.5px; }
    .hero .ctas .btn { flex: 1; }
    .countdown b { font-size: 28px; }
    .form-shell iframe { height: 1700px; }
    .gallery { padding-top: 76px; }
    .shot { width: 240px; }
    .sticky-cta { display: block; }
    nav.top .btn { display: none; }
  }
</style>
</head>
<body>

<nav class="top">
  <div class="wrap">
    <a href="#top" class="brand">Rally<span>Farm</span></a>
    <ul>
      <li><a href="#season">Season</a></li>
      <li><a href="#details">Details</a></li>
      <li><a href="#schedule">Schedule</a></li>
      <li><a href="#package">Package</a></li>
      <li><a href="#register">Register</a></li>
    </ul>
    <a href="#register" class="btn btn-primary">Register</a>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">Season finale · December 5, 2026</div>
      <h1 class="display">
        <span class="accent">Dirt</span> Autocross<br>
        <span class="outline">&amp; NESR 2026</span><br>
        Awarding
      </h1>
      <p class="sub">One last day of sideways for the year. <strong>Unlimited runs, lunch on us</strong>, then trophies for the NESR 2026 season and a Christmas party to close it out.</p>
      <div class="meta-row">
        <span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>Sat · Dec 5, 2026</span>
        <span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>10:00 AM onward</span>
        <span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg><span data-venue-short>Rally Farm</span></span>
      </div>
      <div class="ctas">
        <a href="#register" class="btn btn-primary">Register now · ₱2,000
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a href="#schedule" class="btn btn-ghost">See schedule</a>
      </div>
      <div class="countdown" id="countdown" aria-label="Countdown to event">
        <div><b data-cd="d">--</b><span>Days</span></div>
        <div><b data-cd="h">--</b><span>Hours</span></div>
        <div><b data-cd="m">--</b><span>Mins</span></div>
        <div><b data-cd="s">--</b><span>Secs</span></div>
      </div>
    </div>

    <div class="poster">
