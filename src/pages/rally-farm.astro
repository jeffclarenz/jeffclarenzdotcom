  </div>
  <a href="#season" class="scroll-cue" aria-label="Scroll down"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></a>
</header>

<div class="tape" aria-hidden="true">
  <div class="tape-track"></div>
</div>

<section class="gallery" id="season">
  <div class="wrap">
    <div class="sec-head reveal">
