    </div>
  </div>
  <div class="strips">
    {photos.length ? (
      <>
        <div class="strip">
          {[...rowA, ...rowA].map((src, i) => (
            <button class="shot" type="button" data-full={src} aria-hidden={i >= rowA.length ? 'true' : undefined} tabindex={i >= rowA.length ? -1 : undefined}>
              <img src={src} alt="NESR 2026 season photo" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
        <div class="strip rev">
          {[...rowB, ...rowB].map((src, i) => (
            <button class="shot" type="button" data-full={src} aria-hidden={i >= rowB.length ? 'true' : undefined} tabindex={i >= rowB.length ? -1 : undefined}>
              <img src={src} alt="NESR 2026 season photo" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </>
    ) : (
      <div class="strip">
        {Array.from({ length: 12 }, (_, i) => <div class="shot ph">Season photo {(i % 6) + 1}</div>)}
      </div>
    )}
  </div>
</section>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo"><img alt="" /></div>

<section class="block" id="details">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2 class="display">Event details</h2>
    </div>
    <div class="details">
      <div class="detail reveal">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></div>
        <h3>Date</h3><p>Saturday,<br>December 5, 2026</p>
      </div>
      <div class="detail reveal">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
        <h3>Time</h3><p>10:00 AM registration<br>until the party ends</p>
      </div>
      <div class="detail reveal">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
        <h3>Venue</h3><p><span data-venue>Rally Farm</span><br><a data-map href="#" target="_blank" rel="noopener">Open in Maps →</a></p>
      </div>
      <div class="detail reveal">
        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 17h14l-1.5-5.5a2 2 0 0 0-1.9-1.5H8.4a2 2 0 0 0-1.9 1.5L5 17Z"/><circle cx="8" cy="17" r="2"/><circle cx="16" cy="17" r="2"/></svg></div>
        <h3>Format</h3><p>Dirt autocross,<br>timed runs by class</p>
      </div>
    </div>
  </div>
</section>

<section class="block" id="schedule" style="padding-top: 0">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2 class="display">Schedule</h2>
      <p>Times are approximate. Arrive early, as tech inspection happens during registration.</p>
    </div>
    <div class="schedule">
      <div class="slot reveal">
        <time>10:00</time>
        <div><h3>Registration</h3><p>Check-in, payment verification, car numbers and tech inspection.</p></div>
      </div>
      <div class="slot reveal">
        <time>13:00</time>
        <div><h3>Runs / Shakedowns</h3><p>Unlimited runs on the dirt course. Run groups go out by class.</p></div>
      </div>
      <div class="slot award reveal">
        <time>16:00</time>
        <div class="award-body"><img class="nesr" src="/rally-farm/logo-nesr.png" alt="N. Ecija Sprint Rally Series 2026" width="204" height="110"><div><h3>NESR 2026 Awarding</h3><p>Season champions and class winners take the podium.</p></div></div>
      </div>
      <div class="slot xmas reveal">
        <time>17:00</time>
        <div><h3>Christmas Party</h3><p>Wrap up the season with the whole paddock.</p></div>
      </div>
    </div>
  </div>
</section>

<section class="block" id="package" style="padding-top: 0">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2 class="display">Package</h2>
    </div>
    <div class="package-grid">
      <div class="price-card reveal">
        <div class="price"><sup>₱</sup>2,000</div>
        <div class="per">Per driver · per car</div>
        <ul class="incl">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>Unlimited runs, all afternoon</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>Lunch included</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>NESR 2026 Awarding ceremony</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>Christmas party access</li>
        </ul>
      </div>

      <div class="pay-card reveal">
        <h3>How to register</h3>
        <ol class="steps">
          <li><div><strong>Pay the ₱2,000 entry fee</strong>Send it to the account below and screenshot the receipt.</div></li>
          <li><div><strong>Fill out the registration form</strong>Driver details, vehicle class and your preferred car number.</div></li>
          <li><div><strong>Upload proof of payment</strong>Attach the screenshot in the form and submit. We'll confirm your slot.</div></li>
        </ol>
        <div class="pay-box">
          <div class="acct">
            <div>
              <small data-pay-method>GCash</small>
              <b data-pay-number>0917 000 0000</b>
              <div style="color: var(--muted); font-size: 15px" data-pay-name>Account Name</div>
            </div>
            <button class="copy" type="button" id="copyBtn">Copy number</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="block register" id="register">
  <div class="wrap reg-grid">
    <div class="reveal">
      <h2 class="display" style="font-size: clamp(40px, 6vw, 72px); margin: 0">Register</h2>
      <p style="color: var(--muted); margin: 14px 0 0">Have these ready before you start:</p>
      <ul class="checklist">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>Driver name, contact &amp; license details</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 17h14l-1.5-5.5a2 2 0 0 0-1.9-1.5H8.4a2 2 0 0 0-1.9 1.5L5 17Z"/><circle cx="8" cy="17" r="2"/><circle cx="16" cy="17" r="2"/></svg>Vehicle make, model &amp; class</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M10 9h3v7"/></svg>Preferred car number</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>Proof of payment screenshot</li>
      </ul>
      <p class="note">Uploading a file needs you to be signed in to Google. If the form doesn't load below, <a data-form-link href="#" target="_blank" rel="noopener">open it in a new tab</a>.</p>
    </div>

    <div class="form-shell reveal">
      <div class="bar">
        <span>Registration form</span>
        <a data-form-link href="#" target="_blank" rel="noopener">Open in new tab ↗</a>
      </div>
      <div id="formMount"></div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="sponsor">Sponsored by <img src="/rally-farm/logo-rallyfarm.png" alt="RallyFarm Sports Complex" width="342" height="132"></div>
    <div>Dirt Autocross &amp; NESR 2026 Awarding · December 5, 2026</div>
    <div>Questions? <a data-contact href="#" style="color: var(--dirt-2)">Message the organizers</a></div>
  </div>
</footer>


<script>
  // ============ EVENT CONFIG: edit these ============
  const CONFIG = {
    // Google Form "Send > <> Embed" link, or the plain viewform link. Both work.
    FORM_URL: '',
    VENUE: 'RallyFarm Sports Complex, Nueva Ecija',  // full venue / address line
    MAP_URL: 'https://maps.google.com/?q=RallyFarm+Sports+Complex+Nueva+Ecija',
    PAY_METHOD: 'GCash',
    PAY_NUMBER: '0917 000 0000',
    PAY_NAME: 'Account Name',
    CONTACT_URL: '#',                    // e.g. https://m.me/yourpage
    EVENT_START: '2026-12-05T10:00:00+08:00',
  };

  const $$ = (s) => document.querySelectorAll(s);
  $$('[data-venue]').forEach(el => el.textContent = CONFIG.VENUE);
  $$('[data-map]').forEach(el => el.href = CONFIG.MAP_URL);
  $$('[data-pay-method]').forEach(el => el.textContent = CONFIG.PAY_METHOD);
  $$('[data-pay-number]').forEach(el => el.textContent = CONFIG.PAY_NUMBER);
  $$('[data-pay-name]').forEach(el => el.textContent = CONFIG.PAY_NAME);
  $$('[data-contact]').forEach(el => el.href = CONFIG.CONTACT_URL);

  // Google Form embed
  const mount = document.getElementById('formMount');
  const idMatch = CONFIG.FORM_URL.match(/\/forms\/d\/(e\/)?([\w-]+)/);
  if (idMatch) {
    const base = `https://docs.google.com/forms/d/${idMatch[1] || ''}${idMatch[2]}/viewform`;
    $$('[data-form-link]').forEach(el => el.href = base);
    mount.innerHTML = `<iframe src="${base}?embedded=true" loading="lazy" title="Registration form">Loading…</iframe>`;
  } else {
    mount.innerHTML = '<div class="form-placeholder">Registration form goes here.<br>Set <code>FORM_URL</code> in the config at the bottom of this file.</div>';
  }

  // Copy payment number
  document.getElementById('copyBtn').addEventListener('click', async (e) => {
    try {
      await navigator.clipboard.writeText(CONFIG.PAY_NUMBER.replace(/\s/g, ''));
      e.target.textContent = 'Copied ✓';
    } catch { e.target.textContent = CONFIG.PAY_NUMBER; }
    setTimeout(() => e.target.textContent = 'Copy number', 2000);
  });

  // Countdown
  const target = new Date(CONFIG.EVENT_START).getTime();
  const cd = { d: document.querySelector('[data-cd=d]'), h: document.querySelector('[data-cd=h]'), m: document.querySelector('[data-cd=m]'), s: document.querySelector('[data-cd=s]') };
  function tick() {
    let diff = Math.max(0, target - Date.now()) / 1000;
    if (diff === 0) { document.getElementById('countdown').innerHTML = '<div style="grid-column:1/-1"><b>Race day</b><span>See you on the dirt</span></div>'; return; }
    const d = Math.floor(diff / 86400); diff %= 86400;
    const h = Math.floor(diff / 3600); diff %= 3600;
    const m = Math.floor(diff / 60); const s = Math.floor(diff % 60);
    cd.d.textContent = d; cd.h.textContent = String(h).padStart(2, '0');
    cd.m.textContent = String(m).padStart(2, '0'); cd.s.textContent = String(s).padStart(2, '0');
    setTimeout(tick, 1000);
  }
  tick();

  // Gallery lightbox
  const lb = document.getElementById('lightbox');
  const lbImg = lb.querySelector('img');
  document.querySelectorAll('.shot[data-full]').forEach(btn => btn.addEventListener('click', () => {
    lbImg.src = btn.dataset.full; lb.classList.add('open');
  }));
  lb.addEventListener('click', () => lb.classList.remove('open'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') lb.classList.remove('open'); });

  // Nav appears once the hero scrolls out of view
  const nav = document.querySelector('nav.top');
  new IntersectionObserver(([en]) => {
    nav.classList.toggle('show', !en.isIntersecting);
  }, { rootMargin: '-64px 0px 0px 0px' }).observe(document.getElementById('top'));

  // Scroll reveal
  const io = new IntersectionObserver((entries) => entries.forEach(en => {
    if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
  }), { threshold: 0.12 });
  $$('.reveal').forEach(el => io.observe(el));
</script>
</body>
</html>
