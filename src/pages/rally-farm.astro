<div class="sticky-cta"><a href="#register" class="btn btn-primary">Register · ₱2,000</a></div>

<script>
  // ============ EVENT CONFIG: edit these ============
  const CONFIG = {
    // Google Form "Send > <> Embed" link, or the plain viewform link. Both work.
    FORM_URL: '',
    VENUE: 'Rally Farm',                 // full venue / address line
    MAP_URL: 'https://maps.google.com/?q=Rally+Farm',
    PAY_METHOD: 'GCash',
    PAY_NUMBER: '0917 000 0000',
    PAY_NAME: 'Account Name',
    CONTACT_URL: '#',                    // e.g. https://m.me/yourpage
    EVENT_START: '2026-12-05T10:00:00+08:00',
  };

  const $$ = (s) => document.querySelectorAll(s);
  $$('[data-venue]').forEach(el => el.textContent = CONFIG.VENUE);
  $$('[data-map]').forEach(el => el.href = CONFIG.MAP_URL);
  $$('[data-pay-method]').forEach(el => el.textContent = CONFIG.PAY_METHOD);
  $$('[data-pay-number]').forEach(el => el.textContent = CONFIG.PAY_NUMBER);
  $$('[data-pay-name]').forEach(el => el.textContent = CONFIG.PAY_NAME);
  $$('[data-contact]').forEach(el => el.href = CONFIG.CONTACT_URL);

  // Google Form embed
  const mount = document.getElementById('formMount');
  const idMatch = CONFIG.FORM_URL.match(/\/forms\/d\/(e\/)?([\w-]+)/);
  if (idMatch) {
    const base = `https://docs.google.com/forms/d/${idMatch[1] || ''}${idMatch[2]}/viewform`;
    $$('[data-form-link]').forEach(el => el.href = base);
    mount.innerHTML = `<iframe src="${base}?embedded=true" loading="lazy" title="Registration form">Loading…</iframe>`;
  } else {
    mount.innerHTML = '<div class="form-placeholder">Registration form goes here.<br>Set <code>FORM_URL</code> in the config at the bottom of this file.</div>';
  }

  // Copy payment number
  document.getElementById('copyBtn').addEventListener('click', async (e) => {
    try {
      await navigator.clipboard.writeText(CONFIG.PAY_NUMBER.replace(/\s/g, ''));
      e.target.textContent = 'Copied ✓';
    } catch { e.target.textContent = CONFIG.PAY_NUMBER; }
    setTimeout(() => e.target.textContent = 'Copy number', 2000);
  });

  // Countdown
  const target = new Date(CONFIG.EVENT_START).getTime();
  const cd = { d: document.querySelector('[data-cd=d]'), h: document.querySelector('[data-cd=h]'), m: document.querySelector('[data-cd=m]'), s: document.querySelector('[data-cd=s]') };
  function tick() {
    let diff = Math.max(0, target - Date.now()) / 1000;
    if (diff === 0) { document.getElementById('countdown').innerHTML = '<div style="grid-column:1/-1"><b>Race day</b><span>See you on the dirt</span></div>'; return; }
    const d = Math.floor(diff / 86400); diff %= 86400;
    const h = Math.floor(diff / 3600); diff %= 3600;
    const m = Math.floor(diff / 60); const s = Math.floor(diff % 60);
    cd.d.textContent = d; cd.h.textContent = String(h).padStart(2, '0');
    cd.m.textContent = String(m).padStart(2, '0'); cd.s.textContent = String(s).padStart(2, '0');
    setTimeout(tick, 1000);
  }
  tick();

  // Gallery lightbox
  const lb = document.getElementById('lightbox');
  const lbImg = lb.querySelector('img');
  document.querySelectorAll('.shot[data-full]').forEach(btn => btn.addEventListener('click', () => {
    lbImg.src = btn.dataset.full; lb.classList.add('open');
  }));
  lb.addEventListener('click', () => lb.classList.remove('open'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') lb.classList.remove('open'); });

  // Scroll reveal
  const io = new IntersectionObserver((entries) => entries.forEach(en => {
    if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
  }), { threshold: 0.12 });
  $$('.reveal').forEach(el => io.observe(el));
</script>
