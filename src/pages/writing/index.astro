---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getPosts } from '../../lib/sanity';

const posts = await getPosts();
---
<Layout title="Writing — Jeff Clarenz">
  <Nav active="writing" />
  <main style="flex: 1;">
    <div class="r-px animate-up" style="max-width: 760px; margin: 0 auto; padding: 72px 40px 20px;">
      <h1 class="r-page-h1" style="font-family: 'Space Grotesk', sans-serif; font-size: 40px; font-weight: 600; letter-spacing: -0.025em; margin: 0 0 14px; line-height: 1.1;">Notes on building.</h1>
      <p style="font-size: 16px; line-height: 1.65; color: var(--muted, #5a635e); margin: 0 0 48px; max-width: 560px;">Occasional writing on infrastructure, architecture, and what AI-assisted engineering actually changes day to day.</p>
      <div>
        {posts.map(post => (
          <a href={`/writing/${post.slug}`} style="display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding: 22px 0; border-top: 1px solid var(--border, #e3e8e6); text-decoration: none; cursor: pointer;">
            <div style="min-width: 0;">
              <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 19px; font-weight: 600; margin: 0; color: var(--ink, #141821); line-height: 1.3;">{post.title}</h3>
              <p style="font-size: 14px; color: var(--muted, #5a635e); margin: 8px 0 0; line-height: 1.55;">{post.excerpt}</p>
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--subtle, #9aa39e); margin-top: 10px; letter-spacing: 0.04em;">{post.date} · {post.tags}</div>
            </div>
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #1f9d63; white-space: nowrap; flex-shrink: 0;">read →</span>
          </a>
        ))}
        <div style="height: 1px; background: #e3e8e6;"></div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
